# =====================================================================
#  MADI — Environment variables (TEMPLATE)
#  Copy this file to `.env` and fill in the real values.
# =====================================================================

# ---------------------------------------------------------------------
#  Apify — Finca Raíz scraper actor
# ---------------------------------------------------------------------
APIFY_API_TOKEN=apify_api_REPLACE_ME
APIFY_ACTOR_ID=knowten/finca-raiz-scraper

# ---------------------------------------------------------------------
#  PostgreSQL
#    1) POSTGRES_DB   -> Airflow metadata database
#    2) DWH_DATABASE  -> Data Warehouse
# ---------------------------------------------------------------------
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Data Warehouse
DWH_DATABASE=madi_dwh
DWH_STAGING_SCHEMA=staging

# ---------------------------------------------------------------------
#  Airflow
# ---------------------------------------------------------------------
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_WEBSERVER_PORT=8080
